<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F3F3">

    <!-- Nội dung chính -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Toolbar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="104dp"
            android:background="@drawable/button_gradient1"
            app:titleTextColor="#FFFFFF">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingEnd="16dp">

                <TextView
                    android:id="@+id/tv_account_balance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Số dư: 0 VNĐ"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btn_logout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đăng Xuất"
                    android:backgroundTint="#D32F2F"
                    android:textColor="#FFFFFF"
                    android:padding="8dp" />
            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>

        <!-- Thanh tìm kiếm sinh viên -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_search_student"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="Nhập mã sinh viên">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_search_student"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/btn_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tìm" />
        </LinearLayout>

        <!-- Thông tin sinh viên -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thông tin Sinh viên"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#0D47A1"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_student_id"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Mã số sinh viên"
                    android:enabled="false"
                    app:boxBackgroundColor="#F1F7FD">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_student_id"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="12dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_student_name"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Tên sinh viên"
                    android:enabled="false"
                    app:boxBackgroundColor="#F1F7FD">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_student_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="12dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_student_email"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Email"
                    android:enabled="false"
                    app:boxBackgroundColor="#F1F7FD">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_student_email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Bảng môn học -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp">

            <TableLayout
                android:id="@+id/tl_courses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="*"
                android:padding="8dp">

                <!-- Header -->
                <TableRow android:background="#0D47A1">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Mã môn"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:padding="8dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Tên môn"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:padding="8dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Số tín chỉ"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:padding="8dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Số tiền"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:padding="8dp" />
                </TableRow>

                <!-- Tổng học phí -->
                <TableRow android:background="#E0E0E0">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="4"
                        android:gravity="end"
                        android:text="Tổng học phí"
                        android:textStyle="bold"
                        android:padding="8dp" />

                    <TextView
                        android:id="@+id/tv_total_fee"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="0đ"
                        android:textStyle="bold"
                        android:textColor="#D32F2F"
                        android:padding="8dp" />
                </TableRow>
            </TableLayout>
        </androidx.cardview.widget.CardView>

        <!-- Nút thanh toán -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_margin="16dp">

            <Button
                android:id="@+id/btn_pay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="THANH TOÁN"
                android:backgroundTint="#0D47A1"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Bảng lịch sử giao dịch -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp">

            <TableLayout
                android:id="@+id/tableTransactions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="*"
                android:padding="8dp">

                <!-- Header (đã loại bỏ cột "Người Chuyển Khoản") -->
                <TableRow android:background="#EEEEEE">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Mã SV được thanh toán"
                        android:textStyle="bold"
                        android:padding="8dp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Số tiền"
                        android:textStyle="bold"
                        android:padding="8dp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Ngày giờ"
                        android:textStyle="bold"
                        android:padding="8dp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Trạng thái"
                        android:textStyle="bold"
                        android:padding="8dp"/>
                </TableRow>

                <!-- Các row động sẽ được thêm bằng code -->
            </TableLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <!-- Sidebar -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#0D47A1"
        app:headerLayout="@layout/nav_header"/>
</androidx.drawerlayout.widget.DrawerLayout>